# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production/Render)
DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Use individual environment variables (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=church
DB_USER=postgres
DB_PASSWORD=Admin

NODE_ENV=development

# Frontend API URL (production)
VITE_API_URL=https://churchapi-o3pk.onrender.com/api

# Serve built frontend from Express (set to true for single-service deploy)
SERVE_STATIC=false

# Public app URL (used for QR check-in links)
APP_URL=https://church-ae7v.onrender.com

# SMS Messaging — Intek SMS (Ghana) or stub/Twilio fallback
MESSAGING_PROVIDER=intek
SMS_ENABLED=true
INTEK_API_URL=https://www.inteksms.top/api/v1
INTEK_SENDER=mychurch
# INTEK_API_KEY=your_intek_api_key_here

# Twilio (optional alternative)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1234567890

# Server Configuration
PORT=3001

# AI Configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
