# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production/Render)
DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Use individual environment variables (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=church
DB_USER=postgres
DB_PASSWORD=Admin

# Server Configuration
PORT=3001

# AI Configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
